<?xml version="1.0" encoding="utf-8"?>
<!--
    WinRun Windows 11 ARM64 Unattended Installation Answer File
    
    This file automates Windows 11 ARM64 installation for the WinRun VM.
    Place on a virtual floppy drive - Windows Setup will find it automatically.
    
    Account: Local "WinRun" user with admin rights (blank password, auto-login)
    Locale: US English defaults (user can change later)
    Post-install: Runs C:\WinRun\provision\provision.ps1 on first logon
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

    <!-- ============================================== -->
    <!-- PASS 1: windowsPE - Windows Setup Environment  -->
    <!-- ============================================== -->
    <settings pass="windowsPE">
        
        <!-- International settings during setup -->
        <component name="Microsoft-Windows-International-Core-WinPE" 
                   processorArchitecture="arm64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS" 
                   xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <SetupUILanguage>
                <UILanguage>en-US</UILanguage>
            </SetupUILanguage>
            <InputLocale>0409:00000409</InputLocale>
            <SystemLocale>en-US</SystemLocale>
            <UILanguage>en-US</UILanguage>
            <UserLocale>en-US</UserLocale>
        </component>

        <!-- Windows Setup configuration -->
        <component name="Microsoft-Windows-Setup" 
                   processorArchitecture="arm64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS" 
                   xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            
            <!-- VirtIO drivers for graphics, storage, and network during setup -->
            <!-- Drive letters vary by media ordering (installer/autounattend/virtio). -->
            <!-- Required for VZVirtualMachineView display to work during installation -->
            <DriverPaths>
                <!-- VirtIO GPU (viogpudo) - enables graphics display during setup -->
                <PathAndCredentials wcm:action="add" wcm:keyValue="1">
                    <Path>D:\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="2">
                    <Path>E:\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="3">
                    <Path>F:\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="4">
                    <Path>G:\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="5">
                    <Path>H:\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="6">
                    <Path>D:\virtio-win\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="7">
                    <Path>E:\virtio-win\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="8">
                    <Path>F:\virtio-win\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="9">
                    <Path>G:\virtio-win\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="10">
                    <Path>H:\virtio-win\viogpudo\w11\ARM64</Path>
                </PathAndCredentials>
                <!-- VirtIO Storage (viostor) - may improve disk performance -->
                <PathAndCredentials wcm:action="add" wcm:keyValue="11">
                    <Path>D:\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="12">
                    <Path>E:\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="13">
                    <Path>F:\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="14">
                    <Path>G:\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="15">
                    <Path>H:\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="16">
                    <Path>D:\virtio-win\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="17">
                    <Path>E:\virtio-win\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="18">
                    <Path>F:\virtio-win\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="19">
                    <Path>G:\virtio-win\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="20">
                    <Path>H:\virtio-win\viostor\w11\ARM64</Path>
                </PathAndCredentials>
                <!-- VirtIO Network (NetKVM) - enables network during setup -->
                <PathAndCredentials wcm:action="add" wcm:keyValue="21">
                    <Path>D:\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="22">
                    <Path>E:\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="23">
                    <Path>F:\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="24">
                    <Path>G:\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="25">
                    <Path>H:\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="26">
                    <Path>D:\virtio-win\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="27">
                    <Path>E:\virtio-win\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="28">
                    <Path>F:\virtio-win\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="29">
                    <Path>G:\virtio-win\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
                <PathAndCredentials wcm:action="add" wcm:keyValue="30">
                    <Path>H:\virtio-win\NetKVM\w11\ARM64</Path>
                </PathAndCredentials>
            </DriverPaths>

            <!--
                Windows 11 setup can block before disk partitioning when TPM/Secure Boot
                checks fail on generic virtual hardware profiles. These LabConfig keys
                are set early in windowsPE so unattended install can continue.
            -->
            <RunSynchronous>
                <RunSynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Path>cmd /c reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
                    <Description>Bypass TPM requirement for setup</Description>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <Path>cmd /c reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
                    <Description>Bypass Secure Boot requirement for setup</Description>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <Path>cmd /c reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
                    <Description>Bypass RAM requirement guardrail</Description>
                </RunSynchronousCommand>
            </RunSynchronous>
            
            <!-- Disk partitioning for UEFI/GPT boot (required for ARM64) -->
            <DiskConfiguration>
                <Disk wcm:action="add">
                    <DiskID>0</DiskID>
                    <WillWipeDisk>true</WillWipeDisk>
                    <CreatePartitions>
                        <!-- EFI System Partition -->
                        <CreatePartition wcm:action="add">
                            <Order>1</Order>
                            <Size>260</Size>
                            <Type>EFI</Type>
                        </CreatePartition>
                        <!-- Microsoft Reserved Partition -->
                        <CreatePartition wcm:action="add">
                            <Order>2</Order>
                            <Size>16</Size>
                            <Type>MSR</Type>
                        </CreatePartition>
                        <!-- Windows Partition (use remaining space) -->
                        <CreatePartition wcm:action="add">
                            <Order>3</Order>
                            <Extend>true</Extend>
                            <Type>Primary</Type>
                        </CreatePartition>
                    </CreatePartitions>
                    <ModifyPartitions>
                        <!-- Format EFI partition -->
                        <ModifyPartition wcm:action="add">
                            <Order>1</Order>
                            <PartitionID>1</PartitionID>
                            <Format>FAT32</Format>
                            <Label>System</Label>
                        </ModifyPartition>
                        <!-- MSR partition - no formatting needed -->
                        <ModifyPartition wcm:action="add">
                            <Order>2</Order>
                            <PartitionID>2</PartitionID>
                        </ModifyPartition>
                        <!-- Format Windows partition -->
                        <ModifyPartition wcm:action="add">
                            <Order>3</Order>
                            <PartitionID>3</PartitionID>
                            <Format>NTFS</Format>
                            <Label>Windows</Label>
                            <Letter>C</Letter>
                        </ModifyPartition>
                    </ModifyPartitions>
                </Disk>
            </DiskConfiguration>
            
            <!-- Image installation settings -->
            <ImageInstall>
                <OSImage>
                    <!--
                        Retail media can contain multiple images; without InstallFrom metadata,
                        Windows Setup may wait on hidden edition-selection UI.
                    -->
                    <InstallFrom>
                        <MetaData wcm:action="add">
                            <Key>/IMAGE/INDEX</Key>
                            <Value>1</Value>
                        </MetaData>
                    </InstallFrom>
                    <InstallTo>
                        <DiskID>0</DiskID>
                        <PartitionID>3</PartitionID>
                    </InstallTo>
                    <!-- Prevent falling back to interactive partition selection -->
                    <InstallToAvailablePartition>false</InstallToAvailablePartition>
                </OSImage>
            </ImageInstall>
            
            <!-- User data - skip product key entry -->
            <UserData>
                <AcceptEula>true</AcceptEula>
                <FullName>WinRun</FullName>
                <Organization>WinRun</Organization>
                <!-- Empty key = evaluation/generic key will be used -->
                <ProductKey>
                    <WillShowUI>OnError</WillShowUI>
                </ProductKey>
            </UserData>
            
            <!-- Upgrade settings (not applicable for clean install, but prevents prompts) -->
            <UpgradeData>
                <Upgrade>false</Upgrade>
            </UpgradeData>

        </component>

    </settings>

    <!-- ============================================== -->
    <!-- PASS 4: specialize - Machine-specific config  -->
    <!-- ============================================== -->
    <settings pass="specialize">
        
        <!-- Computer name and timezone -->
        <component name="Microsoft-Windows-Shell-Setup" 
                   processorArchitecture="arm64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS" 
                   xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <ComputerName>WINRUN-VM</ComputerName>
            <!-- UTC - host handles timezone display -->
            <TimeZone>UTC</TimeZone>
            <!-- Disable Cortana during OOBE -->
            <DisableAutoDaylightTimeSet>false</DisableAutoDaylightTimeSet>
        </component>

        <!-- Disable Windows Defender SmartScreen prompts during setup -->
        <component name="Microsoft-Windows-Security-SPP-UX" 
                   processorArchitecture="arm64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS" 
                   xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <SkipAutoActivation>true</SkipAutoActivation>
        </component>

        <!-- Deployment settings -->
        <component name="Microsoft-Windows-Deployment" 
                   processorArchitecture="arm64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS" 
                   xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <RunSynchronous>
                <!-- Copy provisioning scripts and installer from attached install media to local disk -->
                <!-- Drive letters vary by install media ordering, so scan a wider range. -->
                <RunSynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Path>cmd /c mkdir C:\WinRun\provision</Path>
                    <Description>Create provisioning directory</Description>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <Path>cmd /c for %%d in (D E F G H I J) do if exist %%d:\*.PS1 copy %%d:\*.PS1 C:\WinRun\provision\</Path>
                    <Description>Copy provisioning scripts from install media root</Description>
                </RunSynchronousCommand>
                <RunSynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <Path>cmd /c for %%d in (D E F G H I J) do if exist %%d:\WinRunAgent.msi copy %%d:\WinRunAgent.msi C:\WinRun\provision\</Path>
                    <Description>Copy WinRunAgent installer from install media root</Description>
                </RunSynchronousCommand>
            </RunSynchronous>
        </component>
        
    </settings>

    <!-- ============================================== -->
    <!-- PASS 7: oobeSystem - First user experience    -->
    <!-- ============================================== -->
    <settings pass="oobeSystem">
        
        <component name="Microsoft-Windows-Shell-Setup" 
                   processorArchitecture="arm64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS" 
                   xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            
            <!-- Skip all OOBE screens -->
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <HideLocalAccountScreen>true</HideLocalAccountScreen>
                <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
                <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
                <NetworkLocation>Work</NetworkLocation>
                <ProtectYourPC>3</ProtectYourPC>
                <SkipMachineOOBE>true</SkipMachineOOBE>
                <SkipUserOOBE>true</SkipUserOOBE>
            </OOBE>
            
            <!-- Create local admin user "WinRun" with blank password -->
            <UserAccounts>
                <LocalAccounts>
                    <LocalAccount wcm:action="add">
                        <Name>WinRun</Name>
                        <DisplayName>WinRun</DisplayName>
                        <Description>WinRun VM User</Description>
                        <Group>Administrators</Group>
                        <Password>
                            <!-- Empty password (encoded as empty base64) -->
                            <Value></Value>
                            <PlainText>true</PlainText>
                        </Password>
                    </LocalAccount>
                </LocalAccounts>
            </UserAccounts>
            
            <!-- Auto-login as WinRun user -->
            <AutoLogon>
                <Enabled>true</Enabled>
                <Username>WinRun</Username>
                <Password>
                    <Value></Value>
                    <PlainText>true</PlainText>
                </Password>
                <!-- Number of auto-logons (0 = unlimited for provisioning, then finalize.ps1 resets) -->
                <LogonCount>9999</LogonCount>
            </AutoLogon>
            
            <!-- Run provisioning script on first logon -->
            <FirstLogonCommands>
                <SynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <CommandLine>powershell.exe -ExecutionPolicy Bypass -NoProfile -File C:\WinRun\provision\provision.ps1</CommandLine>
                    <Description>Run WinRun provisioning</Description>
                    <RequiresUserInput>false</RequiresUserInput>
                </SynchronousCommand>
            </FirstLogonCommands>
            
            <!-- Disable first-run animations and tips -->
            <RegisteredOrganization>WinRun</RegisteredOrganization>
            <RegisteredOwner>WinRun</RegisteredOwner>
            
        </component>

        <!-- International settings for the user -->
        <component name="Microsoft-Windows-International-Core" 
                   processorArchitecture="arm64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS" 
                   xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <InputLocale>0409:00000409</InputLocale>
            <SystemLocale>en-US</SystemLocale>
            <UILanguage>en-US</UILanguage>
            <UserLocale>en-US</UserLocale>
        </component>

    </settings>

</unattend>
